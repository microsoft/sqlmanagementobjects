<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <ProjectFile Include="**\*.csproj" />
    <!-- RegSvrEnumUnitTests only targets net472 (the .NET Framework), which isn't available on non-Windows builds -->
    <ProjectFile Remove="**\Microsoft.SqlServer.Test.RegSvrEnumUnitTests.csproj" Condition="'$(IsWindowsBuild)' != 'true'" />
  </ItemGroup>
</Project>