<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <ProjectReference Include="**\*.csproj" />
    <!-- SqlClrProvider doesn't build for all platforms, let it get pulled in as needed-->
    <ProjectReference Remove="**\Microsoft.SqlServer.SqlClrProvider.csproj" />
    <!-- RegSvrEnum only targets net472 (the .NET Framework), which isn't available on non-Windows builds -->
    <ProjectReference Remove="**\Microsoft.SqlServer.RegSvrEnum.csproj" Condition="'$(IsWindowsBuild)' != 'true'" />
  </ItemGroup>
</Project>