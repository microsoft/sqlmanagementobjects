<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Global locations">
    <!--
      $(MSBuildAllProjects) is a list of files that determine if a project is up-to-date or not.  By including this
      file in the list, it ensures that all projects will be rebuilt if it changes.
    -->
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>

    <!--
      Enlistment root is based off of wherever this file is.  Be sure not to set this property anywhere else.
    -->
    <EnlistmentRoot>$(MSBuildThisFileDirectory.TrimEnd('\\'))</EnlistmentRoot>
    <!-- Whether we are building on a Windows OS. net472 (the .NET Framework) can only be built/run on Windows,
         so builds on other OSes (e.g. Linux) skip it and only produce netstandard2.0/net8.0/net10.0 assemblies. -->
    <IsWindowsBuild Condition="'$(IsWindowsBuild)'==''">$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsBuild>
    <NetfxVersion Condition="'$(IsWindowsBuild)'=='true'">net472</NetfxVersion>
  </PropertyGroup>

  <!-- BinSkim BA2004: EnableSecureSourceCodeHashing (C#) -->
  <PropertyGroup>
    <ChecksumAlgorithm>SHA256</ChecksumAlgorithm>
  </PropertyGroup>
</Project>
